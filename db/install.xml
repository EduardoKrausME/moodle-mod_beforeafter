<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/beforeafter/db" VERSION="20260914" COMMENT="XMLDB file for mod_beforeafter"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="beforeafter" COMMENT="Before and after activity instances">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="beforeprompt" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="afterprompt" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="afterreleased" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timereleased" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="beforeafter_entries" COMMENT="Student responses for before and after moments">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="beforeafterid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="beforetext" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="beforeformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="aftertext" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="afterformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="timebefore" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timeafter" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="beforeafter" TYPE="foreign" FIELDS="beforeafterid" REFTABLE="beforeafter" REFFIELDS="id"/>
                <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="beforeafter_user_uix" UNIQUE="true" FIELDS="beforeafterid, userid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
